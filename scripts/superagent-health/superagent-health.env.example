# superagent-health 运行时配置(装到 /root/.dsh/superagent-health.env,chmod 600)
#
# 这个文件在仓库外,不要提交。装完先按下面填一行通道,否则告警只落盘不发。

# ── 要核对「入队三连」的 issue(空格分隔)。派出去的单一律写进来 ────────────
# 派单后忘加 = 少一项检查,但不会误报;卡死的 assignment 是自动扫的,不依赖这里。
#SUPERAGENT_HEALTH_ISSUES="285 280 281"

# ── 告警通道:二选一(优先级 1 > 2)──────────────────────────────────────

# 1) 逃生口:任意命令,主题 + 正文从 stdin 一起进来
#SUPERAGENT_NOTIFY_CMD='mail -s "chatapp 巡检" you@example.com'

# 2) 统一邮件内核(推荐):与服务器日报**同一个阿里云发信账号**,主题按
#    docs/ops/mail.md 的三段规范渲染(`[chatapp·巡检] worker — 结论`)。
#    smtps:// = 465 隐式 TLS;smtp:// = 587 STARTTLS。邮件不走 http 代理。
#    旧变量名(SUPERAGENT_SMTP_URL / _MAIL_FROM / _MAIL_TO / _SMTP_USER / _SMTP_PASS)
#    仍能识别,由 notify.sh 映射到下面这些名字。
#MAIL_SMTP_URL="smtps://smtpdm.aliyun.com:465"
#MAIL_FROM="<与日报相同的发信地址>"
#MAIL_TO="<收件邮箱,与日报同一地址>"
#MAIL_USER="<发信地址>"
#MAIL_PASS="<发信密码>"

# 去重与配额的状态库 / JSONL 发送日志(默认 ~/.local/state/mail/)
#MAIL_STATE_DB="/root/.dsh/state/superagent-health/mail-state.db"
#MAIL_LOG="/root/.dsh/state/superagent-health/mail.jsonl"

# 额度与日报**共享**(阿里云 5/分钟、50/天):调大之前先算日报那份够不够
#MAIL_PER_MINUTE=5
#MAIL_PER_DAY=50

# 2026-11-16 起**没有**「GitHub issue 评论」通道了 —— issue 是待办不是告警:
# 没人订阅就没人看见,而且类别与结论会被 GitHub 的通知模板抹平。

# ── 阈值与去重(一般不用改)──────────────────────────────────────────────
#SUPERAGENT_HEALTH_RESEND_SECONDS=21600   # 同一种异常 6 小时内只发一次
#SUPERAGENT_ZOMBIE_MINUTES=45             # assignment 多久没结束算卡住(healthcheck 默认值)

# ── 第五项:CI 红轨(2026-11-16 起,**默认关**)──────────────────────────
# 默认分支上有没有 workflow 的最新一次 push run 没跑绿(判据 = scripts/l4_intake.py 的
# red_runs,与 L4 自动入队**同一个函数**,不各写一份)。这一项原先由
# .github/workflows/main-health.yml 建 GitHub issue 承载,2026-11-16 并入巡检、改走邮件。
#
# 已知偏差:WSL 关机期间没人报红轨 —— 与「worker 也不在」是同一段时间;开机后第一轮
# (OnBootSec)会立刻补报。先手动跑几轮看判据与指纹都对,再交给 timer。
#SUPERAGENT_HEALTH_CI_RED=1
#SUPERAGENT_CI_BRANCH="main"              # 分支改名后必须同步,否则静默查空
#SUPERAGENT_HEALTH_REPO="shiliu153/chatapp"

# ── 第四项:游标新鲜度(2026-11-16 起)────────────────────────────────────
# 判据是「有未读通知但游标没动」,不是「游标没动」:闲置时段游标本来就不动。
# 只有游标落后超过阈值时才会去取通知,所以正常路径不联网、不花 GitHub 限流。
#SUPERAGENT_CURSOR_STALE_MINUTES=10        # 游标落后多少分钟才值得深究(默认 10)
#GH_CLI="/root/.dsh/bin/gh-agent"          # 取未读通知用的 GitHub CLI(不填则依次试 gh / gh-agent)

# ── 第五项:安全自愈(2026-11-16 起,**默认关**)──────────────────────────
# 只治一种病:第四项判成「有未读但游标没动」时,在**安全的前提下**替你把
# `bash /root/start-superagent.sh restart` 跑掉。
#
# 四道闸写死在 superagent_health.py 的 maybe_autoreheal 里,任何一条不过就只告警:
#   ① 没有任何 state ∈ {running, pending} 的 assignment(重启不会杀掉正在跑的会话)
#   ② work/ 下每个 worktree 都没有未提交改动(git status --porcelain 为空;确认不了也算脏)
#   ③ 距上一次自愈尝试 ≥ SUPERAGENT_AUTOREHEAL_MIN_MINUTES(防抖)
#   ④ 以上全过才重启;重启命令非零退出 = 按「未自愈」处理(告警里带原因,退出码仍为 1)
#
# 与 L4_INTAKE 同一口径:**机制上线不等于开始执行**。下面这行不写 = 关,
# 行为与本开关上线前完全一致(只告警)。看过 autoreheal.log 里几次真实自愈之后再决定。
#SUPERAGENT_AUTOREHEAL=1
#SUPERAGENT_AUTOREHEAL_MIN_MINUTES=20      # 两次自愈尝试的最小间隔(分钟,默认 20)
#SUPERAGENT_RESTART_SCRIPT=/root/start-superagent.sh   # 默认重启脚本(一般不用改)

# ── 已人工确认作废的僵尸 assignment(空格分隔的 id 前缀)──────────────────
# DSH 没有「取消 assignment」的 CLI/API:被模型流打断的那些会**永远**停在 running。
# 填在这里 = 巡检不再为它告警(信息仍打印,写「已人工确认作废」)。
# 别用它来掩盖新故障 —— 只在确认「这张单已经由别的单/PR 完成」之后填。
#SUPERAGENT_HEALTH_IGNORE_ZOMBIES="ce1d46c9"
