# superagent-health 运行时配置(装到 /root/.dsh/superagent-health.env,chmod 600)
#
# 这个文件在仓库外,不要提交。装完先按下面填一行通道,否则告警只落盘不发。

# ── 要核对「入队三连」的 issue(空格分隔)。派出去的单一律写进来 ────────────
# 派单后忘加 = 少一项检查,但不会误报;卡死的 assignment 是自动扫的,不依赖这里。
#SUPERAGENT_HEALTH_ISSUES="285 280 281"

# ── 告警通道:三选一(优先级 1 > 2 > 3)────────────────────────────────────

# 1) 逃生口:任意命令,正文从 stdin 进来
#SUPERAGENT_NOTIFY_CMD='mail -s "superagent alert" you@example.com'

# 2) SMTP(推荐;curl 直连,不走 http 代理)。QQ 邮箱用「授权码」当密码,
#    465 = smtps(隐式 TLS),587 = smtp + --ssl-reqd。
#SUPERAGENT_SMTP_URL="smtps://smtp.qq.com:465"
#SUPERAGENT_MAIL_FROM="2015747655@qq.com"
#SUPERAGENT_MAIL_TO="2015747655@qq.com"
#SUPERAGENT_SMTP_USER="2015747655@qq.com"
#SUPERAGENT_SMTP_PASS="<授权码>"

# 3) GitHub issue 评论(GitHub 会往账号邮箱投递通知,零新增密钥)。
#    给一个专门收告警的 issue 编号,比如自建的「worker 告警」issue。
#SUPERAGENT_GH_ISSUE="286"
#SUPERAGENT_GH_REPO="shiliu153/chatapp"

# ── 阈值与去重(一般不用改)──────────────────────────────────────────────
#SUPERAGENT_HEALTH_RESEND_SECONDS=21600   # 同一种异常 6 小时内只发一次
#SUPERAGENT_ZOMBIE_MINUTES=45             # assignment 多久没结束算卡住(healthcheck 默认值)
