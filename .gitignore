# Flutter SDK (vendored into repo, has its own git history — never add)
flutter/

# Claude session memory log
.remember/
.claude/settings.local.json

# --- Python / Django ---
__pycache__/
*.py[cod]
.venv/
venv/
.env
db.sqlite3
staticfiles/
media/

# --- Flutter app (app/) ---
app/build/
app/.dart_tool/
app/.flutter-plugins*
app/android/.gradle/
app/android/local.properties
app/ios/Pods/
app/ios/.symlinks/
# 各平台 Flutter 生成的脚手架(`flutter test`/`analyze` 会顺手生成):
# 不入库,否则 WSL 母体一跑 flutter 就变脏,scripts/superagent-closeout.sh 会拒绝同步
app/macos/Flutter/
app/linux/flutter/
app/windows/flutter/

# --- Android 签名(密钥与口令永不入库存) ---
app/android/key.properties
*.jks

# --- 发版准备产物(scripts/release_prep.py 生成的 notes 草稿) ---
.release-notes/

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Playwright MCP artifacts
.playwright-mcp/

# Brainstorm 预览(Mockup)会话产物
.superpowers/

# 压测脚本与原始采样(2026-11-01 压测;含 venv 与服务器日志,不入库)
.stress/

# 观测栈的抓取令牌(部署时从 METRICS_TOKEN 写入,不入库)
deploy/observability/metrics_token

# 观测栈 MySQL 监控账号的口令文件(服务器上生成,600,不入库)
deploy/observability/mysqld_exporter.cnf

# oneclick.sh --render-only 的默认输出目录(含 secrets/values.env 真实密钥)
deploy-render/

# 压测结果(每次跑都产生;只提交 perf/baseline.json)
perf/results/
