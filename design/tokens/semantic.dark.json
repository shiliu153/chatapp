      "page": { "$value": "{color.paper.110}", "$type": "color" },
      "card": { "$value": "{color.paper.95}", "$type": "color" },
      "sunken": { "$value": "{color.paper.120}", "$type": "color" }
    },
    "overlay": {
      "scrim": { "$value": "#000000EB", "$type": "color" },
      "on": { "$value": "{color.paper.0}", "$type": "color", "$description": "遮罩上的文字（Toast）" }
    },
    "text": {
      "primary": { "$value": "{color.paper.10}", "$type": "color" },
      "secondary": { "$value": "{color.paper.50}", "$type": "color" },
      "tertiary": { "$value": "{color.paper.60}", "$type": "color" }
    },
    "border": {
      "divider": { "$value": "{color.paper.92}", "$type": "color" },
      "strong": { "$value": "{color.paper.90}", "$type": "color" }
    },
    "brand": {
      "default": { "$value": "{color.ember.300}", "$type": "color" },
      "on": { "$value": "{color.ember.950}", "$type": "color" }
    },
    "accent": {
      "default": { "$value": "#FFC38F", "$type": "color" },
