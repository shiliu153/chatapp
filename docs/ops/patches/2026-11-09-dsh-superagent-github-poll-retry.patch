+
+describe('network retries', () => {
+  const commands = () => new Commands(() => deployment, {}, new AbortController().signal)
+  const reset = () => new CliError('Get "https://api.github.com/repos/x/y/issues/12": EOF')
+  it('repeats a read the network dropped, and never repeats an HTTP answer or a write', async () => {
+    const value = commands()
+    const run = vi.spyOn(value, 'run').mockRejectedValueOnce(reset()).mockResolvedValue('{"number":12}')
+    expect(await value.api(z.looseObject({ number: z.number() }), 'issues/12')).toEqual({ number: 12 })
+    expect(run).toHaveBeenCalledTimes(2)
+    run.mockReset()
+    run.mockRejectedValue(commandError({ stderr: 'gh: Not Found (HTTP 404)', code: 1 }))
+    await expect(value.api(z.unknown(), 'issues/12')).rejects.toThrow('HTTP 404')
+    expect(run).toHaveBeenCalledTimes(1)
+    // A write is never repeated: the same comment would be posted twice.
+    const gh = vi.spyOn(value, 'gh').mockRejectedValueOnce(reset()).mockResolvedValue({})
+    await expect(value.api(z.unknown(), 'issues/12/comments', '--method', 'POST', '-f', 'body=x')).rejects.toThrow('EOF')
+    expect(gh).toHaveBeenCalledTimes(1)
+  })
+  it('gives up after the last attempt, so a link that stays broken still reaches the polling round', async () => {
+    vi.useFakeTimers()
+    try {
+      const value = commands()
+      const run = vi.spyOn(value, 'run').mockRejectedValue(reset())
+      const failed = value.api(z.unknown(), 'issues/12')
+      const assertion = expect(failed).rejects.toThrow('EOF')
+      await vi.advanceTimersByTimeAsync(5_000)
+      await assertion
+      expect(run).toHaveBeenCalledTimes(4)
+    } finally { vi.useRealTimers() }
+  })
+})
