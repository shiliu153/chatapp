# 由 deploy/oneclick.sh 渲染;不要直接编辑(重跑脚本会覆盖)。
#
# 设计:
#   - 只有 nginx 发布 80/443,MySQL / Redis / Django / imserver 都只在 compose 网络内;
#   - imserver 在容器内监听 0.0.0.0(IM_ALLOW_PUBLIC_BIND=1),但 compose 不发布端口,
#     外部只能经 nginx 的 /im/ws 与 /im/api/ 访问;
#   - 固定子网,便于 Django/imserver 的 TRUSTED_PROXY_IPS 只信任 nginx;
#   - 两张网络(M-6):default 负责对外(nginx/证书/出站),backend 放 MySQL 与 Redis,
#     只有 web/worker/imserver 同时接入。nginx 与 certbot 没有 backend 路由,
#     即使被攻陷也连不到 3306/6379;
#   - 每个服务都有内存与进程上限(M-5):单个服务失控不会把 2C2G 整机拖死;
#   - 外部镜像一律钉成「具体版本 tag + digest」(L-3):tag 只用来读,digest 才是事实 ——
#     registry 上同名 tag 被重推也不影响已部署内容。换版本要改这里并重跑脚本,
#     升级 recipe 见 deploy/README.md §12(用 buildx imagetools 取新 digest,别手抄)。
name: chatapp

x-app: &app
  image: chatapp-web:local
  env_file:
    - "__APP_DIR__/secrets/chatapp.env"
  volumes:
    - chatapp_static:/app/staticfiles
    - chatapp_media:/app/media
  restart: unless-stopped
  # 应用容器不需要任何 Linux capability;禁止通过 setuid 提权
  cap_drop: [ALL]
  security_opt: ["no-new-privileges:true"]
  pids_limit: 256
  logging:
    driver: json-file
    options:
      max-size: "20m"
      max-file: "5"

services:
  mysql:
    # L-3:钉版本 + digest(多架构 index digest,amd64/arm64 都能拉)
    image: mysql:8.0.46@sha256:7dcddc01f13bab2f15cde676d44d01f61fc9f99fe7785e86196dfc07d358ae2b
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --innodb-buffer-pool-size=256M
      - --max-connections=200
    environment:
      MYSQL_ROOT_PASSWORD: "${MYSQL_ROOT_PASSWORD}"
      # L-9:root 只允许来自 compose 子网(默认 172.28.0.%),不是 "%"
      MYSQL_ROOT_HOST: "__MYSQL_ROOT_HOST__"
      MYSQL_DATABASE: chatapp
      MYSQL_USER: chatapp
      MYSQL_PASSWORD: "${DB_PASSWORD}"
      TZ: Asia/Shanghai
    volumes:
      - chatapp_mysql:/var/lib/mysql
    networks: [backend]
    mem_limit: 700m
    pids_limit: 300
    security_opt: ["no-new-privileges:true"]
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uroot -p\"$$MYSQL_ROOT_PASSWORD\" --silent"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "5"

  redis:
    # L-3:钉版本 + digest;7-alpine 是滚动 tag,写死 7.4.12-alpine 才知道自己跑的是哪版
    image: redis:7.4.12-alpine@sha256:7f7d30b7fdd09467bac58198a1f166dd69789d348d4fe859cccb20e0cf287fbe
    # H-1(第四轮 A2 / 第五轮 H-1):Redis 里放着轮换后的 refresh 令牌、DAU 名单、
    # 滑卡额度与所有限流计数,是多个安全控制的信任锚 —— 同网任一容器被拿下即可读改,
    # 所以必须开口令。口令由 oneclick.sh 生成并写进 secrets/values.env,
    # 经 $APP_DIR/.env 插值到这里;Django(DB0 缓存 / DB1 broker)与 imserver(DB2)同一个口令。
    #
    # 口令不进 command(2026-11-17):`--requirepass` 会原样落在 docker inspect 的
    # Config.Cmd 里,任何能跑 docker 的人一眼可见。现在 requirepass / appendonly /
    # maxmemory* 全写进 oneclick.sh 渲染的 $APP_DIR/redis/redis.conf(600),以 :ro
    # 挂进容器;命令行只剩「用哪份配置启动」,不再含任何秘密。
    environment:
      # 只剩健康检查在用(见下面的 healthcheck)。Redis 自身不再从这里取口令:
      # 口令的事实来源是 redis.conf。
      REDIS_PASSWORD: "${REDIS_PASSWORD}"
    command: [redis-server, /usr/local/etc/redis/redis.conf]
    # 直接以容器内 redis 用户(uid 999 / gid 1000)起进程,不靠 entrypoint 的 setpriv 降权。
    #
    # 为什么必须显式写 user(#441,2026-11-17 实测):官方镜像的 docker-entrypoint.sh
    # 在 uid 0 分支里先 `find . ! -user redis -exec chown redis` 再 `setpriv --reuid redis`。
    # 下面的 cap_drop: [ALL] 把 CAP_SETUID/CAP_SETGID 也丢了 —— 实测容器直接
    # `setpriv: setresuid failed: Operation not permitted` 退出码 127,栈里 redis 永远
    # unhealthy,oneclick.sh 卡死在 wait_for_healthy redis。只有 uid 是 0 时 entrypoint 才走
    # 这段,写成非 root 后整段被跳过(setpriv 与 chown 都不再执行),最终进程身份与原先
    # setpriv 降权后完全一致(uid 999 / gid 1000),caps 仍然一枚不留。
    #
    # 为什么不选「cap_add: [SETUID, SETGID] 继续让 entrypoint 降权」(同样实测):首次
    # 启动能成功,但第二次启动(restart / 宿主机重启 / compose down 再 up)必挂 ——
    # /data 里 redis 自己建的 appendonlydir 是 700 且属主 redis,root 在丢了
    # CAP_DAC_READ_SEARCH / CAP_DAC_OVERRIDE 之后连 `find` 都进不去,entrypoint 是
    # `set -e`,`find: ./appendonlydir: Permission denied` 直接退出码 1,容器反复重启。
    # 要修就得再补 DAC 类 capability,越补越多;直接以 999 起进程反而不需要任何 cap。
    #
    # 代价与前提:/data 必须对 999:1000 可写。docker 会在卷首次创建时把镜像里 /data
    # 的内容连同属主(999:1000)一起拷进具名卷,所以正常路径开箱即用;万一 /data 变成
    # 不可写,redis 会以 `Can't open or create append-only dir appendonlydir: Permission
    # denied` 退出(fail-fast,不会「起得来但 AOF 是废的」)。配置文件的属主在
    # oneclick.sh 里已交给 999:1000(600),这里以 :ro 挂载不变。
    user: "999:1000"
    volumes:
      - chatapp_redis:/data
      # 只读挂载:容器里没有任何进程需要改这份配置,只读能挡住「改配置改行为」
      - "__APP_DIR__/redis/redis.conf:/usr/local/etc/redis/redis.conf:ro"
    # M-6:只接 backend,nginx/certbot 没有到 6379 的路由
    networks: [backend]
    mem_limit: 320m
    pids_limit: 128
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    healthcheck:
      # 开了口令后裸 `redis-cli ping` 只会回 NOAUTH,健康检查必须带口令 ——
      # 否则 redis 永远 unhealthy,依赖它的 db-init/web/worker/imserver 全部起不来。
      # `$$` 是 compose 的转义,容器里看到的才是 $REDIS_PASSWORD(取自上面的 environment)。
      test: ["CMD-SHELL", "redis-cli --no-auth-warning -a \"$$REDIS_PASSWORD\" ping | grep -q PONG"]
      interval: 10s
      timeout: 3s
      retries: 30
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "5"

  # 建 chatapp_im 库与 imserver 账号;每次部署都跑,SQL 幂等。
  db-init:
    # 与 mysql 服务同一个镜像(同一 digest),客户端版本不会与服务器版本漂移
    image: mysql:8.0.46@sha256:7dcddc01f13bab2f15cde676d44d01f61fc9f99fe7785e86196dfc07d358ae2b
    depends_on:
      mysql:
        condition: service_healthy
    environment:
      MYSQL_ROOT_PASSWORD: "${MYSQL_ROOT_PASSWORD}"
    volumes:
      - "__APP_DIR__/mysql/init:/init:ro,z"
    entrypoint: ["/bin/sh", "-c"]
    # 必须是一个字符串参数:sh -c 只把紧随其后的第一个参数当命令
    command:
      - mysql -h mysql -uroot -p"$$MYSQL_ROOT_PASSWORD" < /init/01-databases.sql
    restart: "no"
    networks: [backend]
    mem_limit: 192m
    pids_limit: 128
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "5"

  migrate:
    <<: *app
    command: ["python", "manage.py", "migrate", "--noinput"]
    restart: "no"
    # 一次性容器只需要 DB/Redis,不接 default(没有出站需求)
    networks: [backend]
    mem_limit: 384m
    depends_on:
      db-init:
        condition: service_completed_successfully
      redis:
        condition: service_healthy

  web:
    <<: *app
    build:
      context: "__REPO_DIR__"
      dockerfile: deploy/docker/Dockerfile
      # 构建期用宿主网络:部分云主机/桌面 Docker 的 bridge DNS 拉不到 apt/pip 源
      network: host
      args:
        PIP_INDEX_URL: "${PIP_INDEX_URL:-https://mirrors.aliyun.com/pypi/simple/}"
    command: ["gunicorn", "config.wsgi:application", "-b", "0.0.0.0:8000", "-w", "2", "--timeout", "120", "--access-logfile", "-"]
    # default 供 nginx 反代,backend 供 MySQL/Redis
    networks: [default, backend]
    mem_limit: 384m
    depends_on:
      migrate:
        condition: service_completed_successfully
      redis:
        condition: service_healthy
    healthcheck:
      # HTTPS_ENABLED=1 时 Django 会把「非 https」请求 301;直连容器要显式带这个头
      test: ["CMD-SHELL", "curl -fsS -H 'X-Forwarded-Proto: https' http://127.0.0.1:8000/api/v1/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 30s

  worker:
    <<: *app
    command: ["celery", "-A", "config", "worker", "-l", "info", "--concurrency=1"]
    # default 保留出站(接短信商/腾讯 IM 时要用),backend 接 Redis/MySQL
    networks: [default, backend]
    mem_limit: 256m
    depends_on:
      migrate:
        condition: service_completed_successfully
      redis:
        condition: service_healthy

  imserver:
    image: chatapp-imserver:local
    build:
      context: "__REPO_DIR__/imserver"
      dockerfile: Dockerfile
      network: host
    env_file:
      - "__APP_DIR__/secrets/imserver.env"
    # nginx 经 default 反代 /im/ws、/im/api;MySQL/Redis 在 backend
    networks: [default, backend]
    mem_limit: 320m
    pids_limit: 256
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    depends_on:
      db-init:
        condition: service_completed_successfully
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:9101/internal/healthz || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 30s
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "5"

  nginx:
    image: chatapp-nginx:local
    # H-2:固定 IP —— Django/imserver 的可信代理名单只写这一个地址,
    # 不再信任整个 compose 子网(否则任何容器都能伪造 X-Real-IP)。
    networks:
      default:
        ipv4_address: "__NGINX_IP__"
    mem_limit: 96m
    pids_limit: 256
    # E-6①:nginx 以非 root(uid 101)运行,容器内监听 8080/8443,
    # 宿主机 80/443 由 ports 映射进来 —— 不再需要 root 与 NET_BIND_SERVICE。
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    build:
      context: "__REPO_DIR__"
      dockerfile: deploy/docker/web.Dockerfile
      network: host
      args:
        NPM_REGISTRY: "${NPM_REGISTRY:-https://registry.npmmirror.com}"
    ports:
      - "${HTTP_PORT:-80}:8080"
      - "${HTTPS_PORT:-443}:8443"
    volumes:
      # 只挂单个配置文件,不挂整个 conf.d 目录(2026-11-17 实测,#445):
      # oneclick.sh 用 `umask 077` 建 $APP_DIR,`nginx/conf.d` 目录因此是 700;
      # 容器里 nginx 以 uid 101 跑,`ls /etc/nginx/conf.d/` 直接 Permission denied,
      # `include /etc/nginx/conf.d/*.conf` 展开为空 —— nginx 会「起来但一个端口都不监听」,
      # 日志里一句报错都没有,只会让 compose 的 healthcheck 一直 Connection refused。
      # 挂单文件时容器内父目录是镜像里的 /etc/nginx/conf.d(755),uid 101 读得到。
      # 兼容性:oneclick.sh 切换 HTTPS 用的是 `cp https.conf conf.d/default.conf`,
      # 原地写同一个 inode,挂单文件后容器里仍能看到新内容(实测 nginx -t 通过);
      # 但不能用 `mv` / `sed -i` 这类「换 inode」的写法替换它。
      - "__APP_DIR__/nginx/conf.d/default.conf:/etc/nginx/conf.d/default.conf:ro,z"
      - chatapp_static:/srv/static:ro
      - chatapp_media:/srv/media:ro
      - chatapp_certs:/etc/letsencrypt:ro
      - chatapp_acme:/var/www/certbot:ro
    depends_on:
      web:
        condition: service_healthy
      imserver:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/healthz | grep -q ok"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 10s
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "5"

  # 只在签发/续期时用 `docker compose --profile tools run --rm certbot ...` 调用
  certbot:
    # L-3:原来是最糟的 `latest`(完全可变)—— 钉到具体版本 + digest
    image: certbot/certbot:v5.10.0@sha256:c5698da859429ccee0fcc299a8000368198222d1f9e789ab6e388b491e8ce06d
    profiles: ["tools"]
    volumes:
      - chatapp_certs:/etc/letsencrypt
      - chatapp_acme:/var/www/certbot
    entrypoint: ["certbot"]
    networks: [default]
    mem_limit: 128m
    pids_limit: 64
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "5"

volumes:
  # 显式钉住卷名,避免 compose 再套一层项目前缀(chatapp_chatapp_media)
  chatapp_mysql:
    name: chatapp_mysql
  chatapp_redis:
    name: chatapp_redis
  chatapp_static:
    name: chatapp_static
  chatapp_media:
    name: chatapp_media
  chatapp_certs:
    name: chatapp_certs
  chatapp_acme:
    name: chatapp_acme

networks:
  default:
    ipam:
      config:
        - subnet: "__DOCKER_SUBNET__"
  backend:
    # M-6:MySQL/Redis 只挂在这张网上;internal 让这张网单独没有出站路由。
    # 需要出站的服务(web/worker)同时接 default,出站走 default。
    internal: true
