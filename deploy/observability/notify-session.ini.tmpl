# 默认(DSH 会话)邮件配置:部署到服务器 /root/.config/notify/config.ini (权限 600)。
#
# 谁在用:唯一**不传 NOTIFY_CONFIG** 的调用方 —— DSH 的 dsh-email-push 插件(经 SSH 触发),
# 于是它落到这份默认配置上, 主题是 `[chatapp·会话] <对象> — <结论>`。
# 把它绑「会话」而不是「日报」, 是为了不再让会话通知顶着服务器日报的名字(2026-11-16 的根因)。
#
# 为什么每份邮件配置各占一个文件而不是共用一个:四份配置是四个**身份**
# (分工见 docs/ops/mail.md §4),区别只在 [message] 的 from_name / subject_prefix。
#   1. 会话这份写 [chatapp·会话];
#   2. 通道(发信地址/密码来源)、[limits] 配额、[state] 去重库必须与
#      notify-alerts.ini.tmpl / notify-daily.ini.tmpl **逐字一致** —— 三份的
#      [state] path 是同一行、指向同一个 state.db, 这样会话通知与日报、告警共用同一份
#      发信额度(5/分钟、200/天)与同一个去重库, 不会两边各发一遍、额度也不会各算各的。
#
# 用法:
#   install -m 600 deploy/observability/notify-session.ini.tmpl /root/.config/notify/config.ini
#   # 把 <...> 换成真实值, 然后
#   /opt/notify/bin/notify send \
#       --title "chat_app — 第 3 轮结束" --body "hello" --dedup-key session-selftest
#
# 密码不写在这里: 用 password_env 指向 /etc/notify/env 里的变量(该文件 600)。

[message]
to             = <收件邮箱, 三份配置同一个>
from_name      = chatapp 会话
subject_prefix = [chatapp·会话]

# 主通道: 阿里云邮件推送(与其它几份配置同一个发信账号)
[channels.email.directmail]
enabled      = true
host         = smtpdm.aliyun.com
port         = 465
username     = <发信地址, 三份配置同一个>
password_env = NOTIFY_DM_PASSWORD

[limits]
per_minute           = 5
per_day              = 200
dedup_window_minutes = 60

[log]
path = ~/.local/state/notify/notify.jsonl

[state]
path = ~/.local/state/notify/state.db
