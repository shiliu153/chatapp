# 服务器日报专用配置:部署到服务器 /etc/notify/daily.ini (权限 600)。
#
# 谁在用:22:00 的服务器日报(daily-digest.sh 显式 NOTIFY_CONFIG=/etc/notify/daily.ini),
# 它把备份核验结果一起发出去 —— 主题固定 `[chatapp·日报] 服务器 — 无硬故障`。
#
# 为什么每份邮件配置各占一个文件而不是共用一个:四份配置是四个**身份**
# (分工见 docs/ops/mail.md §4),区别只在 [message] 的 from_name / subject_prefix。
#   1. 日报这份写 [chatapp·日报];
#   2. 通道(发信地址/密码来源)、[limits] 配额、[state] 去重库必须与
#      notify-alerts.ini.tmpl / notify-session.ini.tmpl **逐字一致** —— 三份的
#      [state] path 是同一行、指向同一个 state.db, 这样日报和告警共用同一份发信额度
#      (5/分钟、200/天)与同一个去重库, 不会两边各发一遍、额度也不会各算各的。
#
# 用法:
#   install -m 600 deploy/observability/notify-daily.ini.tmpl /etc/notify/daily.ini
#   # 把 <...> 换成真实值, 然后
#   NOTIFY_CONFIG=/etc/notify/daily.ini /opt/notify/bin/notify send \
#       --title "服务器 — 无硬故障" --body "hello" --dedup-key daily-selftest
#
# 密码不写在这里: 用 password_env 指向 /etc/notify/env 里的变量(该文件 600)。

[message]
to             = <收件邮箱, 三份配置同一个>
from_name      = chatapp 日报
subject_prefix = [chatapp·日报]

# 主通道: 阿里云邮件推送(与其它几份配置同一个发信账号)
[channels.email.directmail]
enabled      = true
host         = smtpdm.aliyun.com
port         = 465
username     = <发信地址, 三份配置同一个>
password_env = NOTIFY_DM_PASSWORD

[limits]
per_minute           = 5
per_day              = 200
dedup_window_minutes = 60

[log]
path = ~/.local/state/notify/notify.jsonl

[state]
path = ~/.local/state/notify/state.db
