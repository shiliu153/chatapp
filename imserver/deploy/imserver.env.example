IM_LISTEN_WS=127.0.0.1:9100
IM_LISTEN_HTTP=127.0.0.1:9101
IM_MYSQL_DSN=mysql://imserver:CHANGE_ME@127.0.0.1:3306/chatapp_im
IM_REDIS_URL=redis://127.0.0.1:6379/2
IM_JWT_SECRET=CHANGE_ME_32_BYTES_MIN
IM_INTERNAL_SECRET=CHANGE_ME_32_BYTES_MIN
IM_MIGRATIONS_DIR=/usr/local/share/imserver/migrations
IM_ALLOWED_ORIGINS=https://CHANGE_ME
IM_IO_THREADS=2
IM_DB_THREADS=4
IM_DB_POOL=8
# 单 IP 最大并发 WS 连接(默认 20;压测时可临时调大)
IM_MAX_CONN_PER_IP=20
# 单 IP 鉴权令牌桶:每秒补充速率 / 突发容量(默认 1 / 60)
IM_AUTH_RATE=1
IM_AUTH_BURST=60
IM_MAX_FRAME=8192
IM_TEXT_MAX=2000
