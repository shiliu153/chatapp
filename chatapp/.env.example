SECRET_KEY=CHANGE_ME
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=chatapp_dev
DB_USER=chatapp
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL_DISABLED=1
IM_SDKAPPID=CHANGE_ME
IM_SECRETKEY=CHANGE_ME
AUTO_APPROVE=1
SMS_DEV_MODE=1

REDIS_URL=redis://127.0.0.1:6379/0
BROKER_URL=redis://127.0.0.1:6379/1

# 跑测试时 Redis 的地址(默认 127.0.0.1:6379;端口被占用/CI 里可覆盖,
# 测试固定用 DB15 缓存 + DB14 broker,不会碰开发数据)
# TEST_REDIS_HOST=127.0.0.1
# TEST_REDIS_PORT=6379

# 可选:限流/日志/头像同步(不设置走 settings 默认)
# SMS_SEND_IP_RATE=20/hour
# SMS_VERIFY_IP_RATE=60/hour
# REQUEST_SLOW_MS=500
# LOG_FILE=logs/chatapp.log
# 头像同步给腾讯的绝对 URL;模拟器手测用 http://10.0.2.2:8000(模拟器里 127.0.0.1 指向它自己)
# MEDIA_BASE_URL=http://127.0.0.1:8000
