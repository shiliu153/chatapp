SECRET_KEY=CHANGE_ME
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=chatapp_dev
DB_USER=chatapp
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL_DISABLED=1
# --- 自建 IM(唯一后端;腾讯云 IM 分支已于 2026-11-08 删除,backlog D-4) ---
IM_SELF_URL=http://127.0.0.1:9101
IM_SELF_WS_URL=ws://127.0.0.1:9100/im/ws
IM_SELF_HTTP_URL=http://127.0.0.1:9101/im/api
IM_SELF_SECRET=CHANGE_ME_32_BYTES_MIN
IM_SELF_INTERNAL_SECRET=CHANGE_ME_32_BYTES_MIN
IM_SELF_TOKEN_TTL=86400
# C-1 推送:三态 off / log / jpush。默认 off(彻底不发)。
# log = 只把推送内容打进日志(联调、自测用,永不触网);jpush = 极光真通道,
# 必须同时配齐 JPUSH_APP_KEY / JPUSH_MASTER_SECRET,缺了第一次发信就报错(不静默降级)。
# imserver 侧对应开 IM_PUSH_URL=http://127.0.0.1:8000/internal/push/new-message 才会发事件。
PUSH_PROVIDER=off
# JPUSH_APP_KEY=
# JPUSH_MASTER_SECRET=
# JPUSH_APNS_PRODUCTION=1
# PUSH_LIKE_COOLDOWN_SECONDS=600
# PUSH_DEDUP_TTL=3600
# PUSH_INTERNAL_MAX_SKEW=300
AUTO_APPROVE=1
SMS_DEV_MODE=1
# B-1 / B-1c:准入名单 —— 只有名单内的号码能收发验证码,名单外一律 403 + 40301。
# 名单已落到数据库(accounts.PhoneAllowlist),运营在 /ops/allowlist/ 维护,加号/停用
# **立刻生效、不用重启 web**。这里的值降级为「兜底种子」:库里没有该号码时按它放行;
# 库里显式停用的号码优先被拒。逗号分隔 11 位手机号;库与种子都留空时的行为由下面的
# SMS_ALLOWLIST_STRICT 决定(开发/测试放行,生产拒绝)。
# 生产上线/迁移时用 `python manage.py allowlist_seed_import` 把种子导进库,种子本身保留当安全网。
# SMS_PHONE_WHITELIST=
# 名单快照缓存 TTL(秒);写路径会显式清缓存立刻生效,这里只管「直接改库」时多久被发现
# SMS_ALLOWLIST_CACHE_TTL=60
# 名单为空(库与种子都空)时:留空 = 按 DEBUG 自动(开发/测试放行、生产拒绝);
# "1" 强制拒绝、"0" 强制放行。**生产留空即 fail-closed**:不配名单就谁都登不进来,
# 上线前必须先导库或配种子,否则登录全被 403 挡住(部署期 accounts.E001 也会让 check 变红)。
# SMS_ALLOWLIST_STRICT=
# C-1:运营账号(staff/superuser)默认禁止短信登录,只能走 /ops/ 口令 + TOTP。
# 仅封闭测试需要运营账号登 App 时才设为 1;生产必须保持 0。
# SMS_ALLOW_STAFF_LOGIN=0
# 候选池缓存 TTL(秒);写路径会升版本立即失效,这里只决定无人操作时多久重查
# CANDIDATE_CACHE_TTL=30
# notify 队列消费限速(条/秒);0 = 不限速。imserver 单机天花板 ~215 msg/s
# IM_NOTICE_RATE_PER_SEC=50
# 生产:HTTPS_ENABLED=1(需先配好证书与 X-Forwarded-Proto);OPS_OTP_REQUIRED 默认在 DEBUG=0 时自动为 1
# HTTPS_ENABLED=0
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://example.com
# OPS_OTP_REQUIRED=1
# OPS_ALLOWED_IPS=203.0.113.10
# 第二因子通过后的有效期(秒),默认 12 小时
# OPS_OTP_TTL=43200
# NUM_PROXIES=1
# 可信代理:只有直连对端命中这里才采信 X-Real-IP / X-Forwarded-For(默认回环)
# 生产 Django 只监听 127.0.0.1,由本机 nginx 反代;不要把公网网段写进来
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# Web 的 refresh Cookie 与轮换宽限(一般不用改;多标签并发刷新被误踢时可调大宽限)
# REFRESH_COOKIE_NAME=chatapp_rt
# REFRESH_REUSE_GRACE=60

REDIS_URL=redis://127.0.0.1:6379/0
BROKER_URL=redis://127.0.0.1:6379/1

# 跑测试时 Redis 的地址(默认 127.0.0.1:6379;端口被占用/CI 里可覆盖,
# 测试固定用 DB15 缓存 + DB14 broker,不会碰开发数据)
# TEST_REDIS_HOST=127.0.0.1
# TEST_REDIS_PORT=6379

# 可选:限流/日志/头像同步(不设置走 settings 默认)
# SMS_SEND_IP_RATE=20/hour
# SMS_VERIFY_IP_RATE=60/hour
# 资料抓取监控:同一账号一小时内看多少个不同的人触发 WARNING(默认 60,只告警不拦截)
# PROFILE_SCRAPE_ALERT_PER_HOUR=60
# 访客记录:每个被访问者最多保留最近 N 条(默认 500,<=0 关闭);90 天保留期由
# purge_profile_visits 清理,一键部署的每日维护已包含
# PROFILE_VISIT_MAX_PER_OWNER=500
# 访客列表/人数按用户限流(默认 120 / 240 每小时)
# VISITS_RATE=120/hour
# VISITS_COUNT_RATE=240/hour
# 通知列表/未读数、关注流、回复列表按用户限流(默认 240 / 480 / 240 / 360 每小时)
# NOTIFICATIONS_RATE=240/hour
# NOTIFICATIONS_UNREAD_RATE=480/hour
# FOLLOWING_READ_RATE=240/hour
# COMMENT_REPLIES_RATE=360/hour
# 前端错误上报(POST /client-errors)按 IP 限流;该接口匿名可调,别关掉
# CLIENT_ERROR_RATE=120/hour
# REQUEST_SLOW_MS=500
# LOG_FILE=logs/chatapp.log
# 日志格式:text(开发,终端可读)| json(生产,单行 JSON,Loki/ES 可按字段检索)
# LOG_FORMAT=text
# /metrics 抓取令牌;生产必配,否则只对回环开放
# METRICS_TOKEN=
# Prometheus 多进程指标目录:gunicorn 多 worker 时必须配,否则每个 worker 各记一份、
# 抓取只看得到其中一个(实测 20 次请求两个 worker 分别记 10 / 12)。指向 tmpfs 不占磁盘;
# 目录由 chatapp/gunicorn.conf.py 在 master 启动时清空,worker 退出时删自己的文件。
# PROMETHEUS_MULTIPROC_DIR=/dev/shm/chatapp-prometheus
# 头像同步给 IM 的绝对 URL;模拟器手测用 http://10.0.2.2:8000(模拟器里 127.0.0.1 指向它自己)
# MEDIA_BASE_URL=http://127.0.0.1:8000

# --- 聊天图片签名 URL(生产必填;与 imserver 的同名变量必须完全一致)---
# 留空 = 仅本地 DEBUG 放行;DEBUG=0 时留空会在启动期直接失败(fail-closed),
# 判定在 chatapp/config/settings.py::assert_production_media_sign_secret。
# 注意:空密钥放行的判据就是 DEBUG,所以生产要两件事同时成立 —— 配了密钥,且 DEBUG=0。
# 只有 DEBUG=0 这一半能把「漏配」挡在启动期;漏配又误开 DEBUG=1 时,验签对空密钥放行。
IM_MEDIA_SIGN_SECRET=
# 有效期(秒):默认 1 小时;实际过期点按整点对齐,最多再多 1 小时
IM_MEDIA_SIGN_TTL=3600
CHAT_IMAGE_RETENTION_DAYS=30
CHAT_VOICE_RETENTION_DAYS=30

# --- 每日运营指标快照(V-1)---
# IM 库只读连接,供 manage.py metrics_daily 统计当日消息条数。格式:
#   mysql://user:pass@host:3306/chatapp_im
# 密码里可以带 @(解析时按最后一个 @ 切分);端口缺省 3306。
# 该账号**只需要** chatapp_im 的 SELECT 权限;留空 = 消息量显示「无数据」(其余指标照常)。
# 生产值取自 imserver 的 IM_MYSQL_DSN(不入库)。
IM_MYSQL_DSN=

# --- 存储配额与磁盘告警(M7)---
# 单账号媒体总量上限(MB):资料图 + 广场图 + 聊天图 + 语音;0 = 关闭配额
# 超限时上传返回 413 + 业务码 41301;聊天媒体默认 30 天后过期,空间会自动回收
USER_STORAGE_QUOTA_MB=200
# media_disk_report 的告警线(MB);建议按磁盘剩余空间的 70% 左右设置
MEDIA_DISK_WARN_MB=5000

# --- 候选池(M7)---
# 候选接口按 Profile.shuffle_key 索引取池后再抽样;池子越大越不容易重复
CANDIDATE_POOL_SIZE=200

# --- 滑卡增强(批次 O)---
# 每日喜欢额度:一个账号在一个自然日(Asia/Shanghai)里最多能「喜欢」多少人;
# 0(默认)= 不限,此时不计数也不拦截,行为与加额度前完全一致。
# 计数键 swipe_like:{user_id}:{yyyymmdd} 在 Redis(DB0),次日 0 点自动过期;
# 超限时 POST /api/v1/discovery/swipe(action=like)返回 429 + 42904(跳过不受限)。
# 额度查询:GET /api/v1/discovery/quota。撤销窗口固定 30 秒,不需要配置。
SWIPE_DAILY_LIKE_LIMIT=0
# 撤销滑卡的限流额度(按用户)
# SWIPE_UNDO_RATE=120/hour

